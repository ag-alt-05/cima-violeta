<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cimarrón Violeta</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    
    <link rel="stylesheet" href="~/css/intro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <style>
        /* Forzamos que el contenedor principal ocupe toda la pantalla */
        .app-container {
            position: relative;
            width: 100%;
            height: 100vh;
            overflow: hidden; /* Evita scroll global */
        }

        /* EL FOOTER ES EL REY: Z-INDEX ALTÍSIMO Y FIJO AL FONDO */
        .bottom-nav {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 80px; /* Altura fija de 80px */
            background: linear-gradient(to top, #2c0942, #1a1a1a);
            border-top-left-radius: 25px;
            border-top-right-radius: 25px;
            display: flex;
            justify-content: space-around;
            align-items: center;
            z-index: 3000; /* Mayor que el panel de rutas (500) */
            padding-bottom: 10px;
            flex-shrink: 0;
        }
    </style>
</head>
<body>

    <div class="app-container">
        @RenderBody()

        <nav class="bottom-nav" id="bottom-nav" style="display: none;">
            <a href="/" class="nav-item" id="nav-rutas">
                <i class="bi bi-bus-front-fill"></i>
                <span>Rutas</span>
            </a>
            
            <a href="#" class="nav-item" id="nav-perfil" onclick="irAPerfil(event)" >
                <i class="bi bi-person-fill"></i>
                <span>Perfil</span>
            </a>
        </nav>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        function irAPerfil(e) {
            e.preventDefault();
            const sesion = localStorage.getItem('usuarioRutaVioleta');
            if (sesion) {
                try {
                    const user = JSON.parse(sesion);
                    window.location.href = `/Perfil/${user.nombre_acceso}`;
                } catch (error) {
                    window.location.href = "/Perfil";
                }
            } else {
                window.location.href = "/Perfil";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const path = window.location.pathname;
            const navRutas = document.getElementById('nav-rutas');
            const navPerfil = document.getElementById('nav-perfil');

            if (path.startsWith('/Perfil')) {
                navPerfil.classList.add('active');
                navRutas.classList.remove('active');
            } else {
                navRutas.classList.add('active');
                navPerfil.classList.remove('active');
            }
        });
        const sesionNav = JSON.parse(localStorage.getItem('usuarioRutaVioleta') || '{}');
        if (sesionNav.imagen_perfil) {
            const navPerfil = document.getElementById('nav-perfil');
            navPerfil.innerHTML = `<img src="${sesionNav.imagen_perfil}" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover; margin-bottom: 4px; border: 2px solid #d76cdc;"><span>Perfil</span>`;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>