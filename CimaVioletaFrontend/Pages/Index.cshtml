@page
@model IndexModel
@{
	ViewData["Title"] = "Inicio";
}
<style>
	.tarjeta-ruta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		background-color: #d76cdc;
		border-radius: 15px;
		padding: 10px 15px;
		margin-bottom: 12px;
		color: white;
		font-weight: 600;
		cursor: pointer;
		transition: transform 0.2s;
		gap: 10px;
	}

		.tarjeta-ruta:hover {
			transform: scale(1.02);
		}

		.tarjeta-ruta .ruta-info {
			flex: 1;
			text-align: left;
		}

	.btn-comentarios {
		background-color: #ab00b3;
		color: #fff;
		border: 2px solid #ff4bff;
		padding: 8px 12px;
		border-radius: 8px;
		transition: all 0.3s;
		font-size: 0.8rem;
		display: flex;
		align-items: center;
		gap: 5px;
		cursor: pointer;
		white-space: nowrap;
	}

		.btn-comentarios:hover {
			background-color: #b04cb5;
			border-color: #b04cb5;
		}

	.estrella:hover, .estrella.hover-activa {
		color: #ffc107 !important;
	}

	.btn-regresar {
		background-color: #d76cdc;
		color: white;
		border: none;
		padding: 6px 14px;
		border-radius: 10px;
		font-size: 0.8rem;
		font-weight: bold;
		cursor: pointer;
		margin-right: 10px;
		transition: background 0.3s;
	}

		.btn-regresar:hover {
			background-color: #b04cb5;
		}

	.panel-rutas {
		position: absolute;
		bottom: 0px;
		left: 0;
		margin-bottom: 50px;
		width: 100%;
		background-color: #121212;
		border-top-left-radius: 25px;
		border-top-right-radius: 25px;
		z-index: 500;
		display: flex;
		flex-direction: column;
		height: calc(45% + 10px);
		transition: height 0.3s ease-in-out;
		box-shadow: 0 -5px 15px rgba(0,0,0,0.5);
	}

		.panel-rutas.ruta-seleccionada {
			height: calc(22% + 10px);
		}

		.panel-rutas.oculto {
			height: 65px;
		}

	.panel-rutas-header {
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 10px 0px 25px 0px;
		height: 25px;
		background-color: #1a1a1a;
		border-top-left-radius: 25px;
		border-top-right-radius: 25px;
		border-bottom: 1px solid #333;
		flex-shrink: 0;
	}

		.panel-rutas-header h3 {
			margin: 0;
			padding: 0;
			line-height: 1;
			display: flex;
			align-items: center;
			gap: 8px;
			color: white;
			font-size: 1rem;
		}

	.icono-flecha {
		transition: transform 0.3s ease-in-out;
		font-size: 1.2rem;
		color: #d76cdc;
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
	}

	.panel-rutas.oculto .icono-flecha {
		transform: rotate(180deg);
	}

	.lista-rutas-scroll {
		overflow-y: auto;
		padding: 10px 20px 20px 20px;
		flex: 1;
	}

		.lista-rutas-scroll::-webkit-scrollbar {
			width: 8px;
		}

		.lista-rutas-scroll::-webkit-scrollbar-track {
			background: #121212;
			border-radius: 10px;
		}

		.lista-rutas-scroll::-webkit-scrollbar-thumb {
			background: #d76cdc;
			border-radius: 10px;
		}

			.lista-rutas-scroll::-webkit-scrollbar-thumb:hover {
				background: #b04cb5;
			}

	.barra-busqueda {
		display: flex;
		align-items: center;
		background-color: white;
		border-radius: 30px;
		padding: 5px 15px;
		position: relative;
		margin-top: 10px;
	}

		.barra-busqueda i {
			color: #888;
			font-size: 20px;
		}

		.barra-busqueda input {
			border: none;
			outline: none;
			flex: 1;
			padding: 10px;
			font-size: 0.9rem;
			color: #333;
			background: transparent;
		}

	.header-mapa {
		position: relative;
		z-index: 600;
		overflow: visible !important;
	}

	textarea {
		resize: none;
		overflow-y: hidden;
		min-height: 150px;
	}

	#sugerencias-container {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		margin-top: 8px;
		background: white;
		border-radius: 12px;
		box-shadow: 0 4px 15px rgba(0,0,0,0.2);
		z-index: 2000;
		max-height: 260px;
		overflow-y: auto;
		min-width: 100%;
	}

	.sugerencia-item {
		padding: 10px 15px;
		border-bottom: 1px solid #eee;
		cursor: pointer;
		color: #333;
		font-size: 0.9rem;
	}

		.sugerencia-item:hover {
			background-color: #f5f5f5;
		}

		.sugerencia-item:last-child {
			border-bottom: none;
		}

		.sugerencia-item strong {
			display: block;
			color: #111;
		}

		.sugerencia-item small {
			color: #777;
		}

		.sugerencia-item.cargando, .sugerencia-item.vacio, .sugerencia-item.error {
			text-align: center;
			color: #888;
			cursor: default;
		}

		.sugerencia-item.error {
			color: #f44336;
		}

	#toast-mensaje {
		display: none;
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		background-color: rgba(215, 108, 220, 0.95);
		color: white;
		padding: 15px 30px;
		border-radius: 15px;
		font-weight: bold;
		font-size: 1.5rem;
		z-index: 9999;
		box-shadow: 0 4px 15px rgba(0,0,0,0.3);
		text-align: center;
		transition: opacity 0.3s;
	}

	.intro-overlay {
		background-color: #000;
		transition: background-color 0.8s ease;
	}

	.texto-intro {
		transition: opacity 1s ease-in-out, transform 1s ease-in-out;
	}

		.texto-intro.difuminar {
			opacity: 0 !important;
	}</style>
	<div class="intro-overlay" id="intro-overlay" style="display: none;"><div class="romboide romboide-top" id="romboide-top"></div><div class="romboide romboide-bottom" id="romboide-bottom"></div><div class="centro-intro" id="centro-intro"><img src="~/img/cima.png" alt="Logo" class="logo-intro" id="logo-intro" /><div class="texto-intro" id="texto-cimarron">Cimarrón</div><div class="texto-intro" id="texto-violeta">Violeta</div></div></div>
	<div id="toast-mensaje"></div>
	<div class="ventana-mapa" id="ventana-mapa" style="display: none; flex-direction: column; height: 100%; position: relative;">
		<div class="header-mapa"><div class="info-ubicacion" style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%;"><div><strong id="txt-ubicacion" style="font-size: 2.5rem; display: block; margin-top: 0px; line-height: 1;"><i class="bi bi-geo-alt-fill"></i> Obteniendo...</strong><span id="txt-ultima-actualizacion" style="font-size: 0.8rem; color: rgba(255,255,255,0.7); display: none; margin-top: 5px;">Última actualización: --:--</span></div><button id="btn-toggle-mi-ubicacion" onclick="toggleMiUbicacion()" style="background: rgba(255,255,255,0.2); border: none; color: white; width: 40px; height: 40px; border-radius: 10px; display: flex; justify-content: center; align-items: center; cursor: pointer; transition: background 0.2s;"><i class="bi bi-eye-fill" id="icon-eye" style="font-size: 1.2rem;"></i></button></div><div class="barra-busqueda"><i class="bi bi-search"></i><input type="text" id="input-busqueda" placeholder="Buscar calle o local..." autocomplete="off" /><div id="sugerencias-container"></div></div></div>
		<div class="mapa-container" style="flex: 1; position: relative;">
			<div id="panel-conductor" style="display: none; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding: 20px; text-align: center; background: #121212; position: absolute; top: 0; left: 0; width: 100%; z-index: 1000;"><h2 style="color: white; margin-bottom: 5px;">Modo Conductor</h2><p style="color: #888; margin-bottom: 30px; font-size: 0.9rem;">Selecciona tu unidad y comparte tu ubicación</p><select id="select-autobus-conductor" style="width: 100%; max-width: 300px; padding: 15px; border-radius: 10px; background: #2a2a2a; color: white; border: 1px solid #d76cdc; font-size: 1rem; margin-bottom: 30px; outline: none;"><option value="">Cargando unidades...</option></select><button id="btn-switch-ubicacion" onclick="toggleUbicacion()" style="background-color: #f44336; color: white; border: none; padding: 15px 30px; border-radius: 30px; font-size: 1.1rem; font-weight: bold; cursor: pointer; transition: background 0.3s; display: flex; align-items: center; gap: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.3);"><i class="bi bi-geo-alt-fill"></i><span id="txt-switch-estado">Ubicación Apagada</span></button></div>
			<div id="map" style="width: 100%; height: 100%;"></div>
			<button class="btn-flotante-ubicacion" onclick="centrarEnUsuario()" style="position: absolute; top: 15px; right: 15px; z-index: 400;"><i class="bi bi-geo-alt"></i></button>
		</div>
		<div class="panel-rutas oculto" id="panel-rutas"><div class="panel-rutas-header" onclick="togglePanelRutas()"><h3><i class="bi bi-bus-front-fill"></i> Rutas disponibles</h3><div style="display: flex; align-items: center;"><button id="btn-regresar" class="btn-regresar" style="display: none;" onclick="event.stopPropagation(); regresarRutas()">Regresar</button><i class="bi bi-chevron-down icono-flecha" id="flecha-panel"></i></div></div><div class="lista-rutas-scroll" id="lista-rutas"><p style="color: white; text-align: center; padding: 10px;">Cargando rutas...</p></div></div>
	</div>
	<div id="ventana-comentarios" class="ventana-mapa" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #121212; z-index: 1000; flex-direction: column; padding-bottom: 80px; box-sizing: border-box;"><div class="header-mapa" style="flex-direction: row; justify-content: flex-start; align-items: center; gap: 15px;"><button class="btn-volver-header" onclick="cerrarComentarios()" style="background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer;"><i class="bi bi-chevron-left"></i> Volver</button><span id="nombre-autobus" style="font-weight: bold; color: white; font-size: 1.1rem;">Unidad</span></div><div class="comentarios-barra" id="contenido-comentarios" style="flex: 1; overflow-y: auto; padding: 20px;"></div><div style="padding: 15px; background: #121212; border-top: 1px solid #333;"><button class="btn-dejar-comentario" onclick="abrirFormularioComentario()" style="width: 100%; background-color: #d76cdc; color: white; padding: 15px; border: none; border-radius: 12px; font-weight: bold; font-size: 1rem; cursor: pointer;"><i class="bi bi-chat-dots-fill"></i> Dejar un comentario</button></div></div>
	<div id="formulario-comentario" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #121212; z-index: 1100; padding: 20px 20px 80px 20px; box-sizing: border-box; overflow-y: auto; flex-direction: column;"><div style="display: flex; align-items: center; margin-bottom: 20px;"><button onclick="cerrarFormularioComentario()" style="background: none; border: none; color: white; font-size: 1.5rem; margin-right: 15px; cursor: pointer;"><i class="bi bi-chevron-left"></i></button><h3 style="color: white; margin: 0;">Dejar un Comentario</h3></div><p id="texto-autor-comentario" style="color: #ccc; margin-bottom: 15px; font-size: 0.9rem;"></p><div style="background: #1e1e1e; padding: 15px; border-radius: 12px; margin-bottom: 20px; text-align: center;"><p style="color: white; font-weight: bold; font-size: 1.2rem; margin-bottom: 10px;">Puntuación</p><div id="selector-estrellas" style="font-size: 2.5rem; color: #444; cursor: pointer; display: flex; justify-content: center; gap: 5px;"><span class="estrella" data-val="1">★</span><span class="estrella" data-val="2">★</span><span class="estrella" data-val="3">★</span><span class="estrella" data-val="4">★</span><span class="estrella" data-val="5">★</span></div></div><textarea id="texto-comentario" maxlength="500" placeholder="Escribe tu experiencia... (Mín. 10 caracteres, Máx. 500)" style="width: 100%; background: #2a2a2a; color: white; border: none; padding: 15px; border-radius: 12px; min-height: 150px; font-size: 1rem; box-sizing: border-box; margin-bottom: 20px; font-family: inherit;"></textarea><div id="alerta-comentario" style="display: none; padding: 10px; border-radius: 10px; margin-bottom: 20px; text-align: center;"></div><div style="display: flex; gap: 15px; margin-top: auto;"><button onclick="cerrarFormularioComentario()" style="flex: 1; padding: 15px; border: none; border-radius: 12px; background: #444; color: white; font-weight: bold; cursor: pointer;">Cancelar</button><button id="btn-enviar-comentario" onclick="enviarComentario()" style="flex: 1; padding: 15px; border: none; border-radius: 12px; background: #d76cdc; color: white; font-weight: bold; cursor: pointer;">Enviar</button></div></div>
	<script>
		let map,userMarker,userLat,userLng,idAutobusActual=0,comentariosCargados=0,estrellasSeleccionadas=0,listaAutobuses=[],capaRutaActual=null,capaBusqueda=null,marcadoresParadas=[],panelAbierto=false,destinoLat=null,destinoLng=null,ultimoCalculoLat=null,ultimoCalculoLng=null,debounceTimeout=null,intervaloUbicacion=null,estadoUbicacion=false,marcadoresAutobuses=[],intervaloConsultaBuses=null,esConductor=false,mostrarMiUbicacion=true;
		const API_AUTOBUSES="https://api.4chan.world/api/autobuses",API_COMENTARIOS="https://api.4chan.world/api/comentarios",API_PARADAS="https://api.4chan.world/api/paradas",API_TODAS_PARADAS="https://api.4chan.world/api/paradas/todas";
		document.addEventListener("DOMContentLoaded",function(){const sesion=JSON.parse(localStorage.getItem('usuarioRutaVioleta')||'{}');esConductor=(sesion.es_conductor===true||sesion.es_conductor===1||sesion.es_conductor==="1"||sesion.es_conductor==="true"||sesion.es_conductor==="True");if(esConductor){document.getElementById('map').style.display='none';document.getElementById('map').style.visibility='hidden';document.querySelector('.btn-flotante-ubicacion').style.display='none';document.querySelector('.barra-busqueda').style.display='none';document.getElementById('btn-toggle-mi-ubicacion').style.display='none';document.getElementById('panel-conductor').style.display='flex';document.getElementById('txt-ubicacion').style.marginTop='0';document.getElementById('txt-ultima-actualizacion').style.display='block';actualizarReloj();setInterval(actualizarReloj,1000);if(navigator.geolocation){navigator.geolocation.watchPosition((pos)=>{userLat=pos.coords.latitude;userLng=pos.coords.longitude;},(err)=>console.warn('Error GPS Chofer:',err.message),{enableHighAccuracy:true,maximumAge:0,timeout:10000});}}const yaVioIntro=sessionStorage.getItem('introVista');if(yaVioIntro)mostrarMapa();else{document.getElementById('intro-overlay').style.display='flex';reproducirIntro();}const estrellas=document.querySelectorAll('#selector-estrellas .estrella');estrellas.forEach(star=>{star.addEventListener('mouseover',function(){let val=parseInt(this.getAttribute('data-val'));estrellas.forEach(s=>{if(parseInt(s.getAttribute('data-val'))<=val)s.classList.add('hover-activa');else s.classList.remove('hover-activa');});});star.addEventListener('mouseout',()=>estrellas.forEach(s=>s.classList.remove('hover-activa')));star.addEventListener('click',function(){estrellasSeleccionadas=parseInt(this.getAttribute('data-val'));estrellas.forEach(s=>s.style.color=(parseInt(s.getAttribute('data-val'))<=estrellasSeleccionadas)?'#ffc107':'#444');});});const textarea=document.getElementById('texto-comentario');if(textarea)textarea.addEventListener('input',function(){this.style.height='auto';this.style.height=(this.scrollHeight)+'px';});const inputBusqueda=document.getElementById('input-busqueda'),sugerenciasContenedor=document.getElementById('sugerencias-container');if(inputBusqueda&&sugerenciasContenedor){inputBusqueda.addEventListener('input',function(){clearTimeout(debounceTimeout);const query=this.value.trim();if(query.length<2){sugerenciasContenedor.style.display='none';sugerenciasContenedor.innerHTML='';return;}debounceTimeout=setTimeout(()=>buscarSugerencias(query),350);});inputBusqueda.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();clearTimeout(debounceTimeout);if(this.value.trim().length>=2)buscarSugerencias(this.value.trim());}if(e.key==='Escape')sugerenciasContenedor.style.display='none';});document.addEventListener('click',(e)=>{if(!e.target.closest('.barra-busqueda'))sugerenciasContenedor.style.display='none';});}});
		function toggleMiUbicacion(){mostrarMiUbicacion=!mostrarMiUbicacion;const icon=document.getElementById('icon-eye'),btn=document.getElementById('btn-toggle-mi-ubicacion');if(mostrarMiUbicacion){icon.className='bi bi-eye-fill';btn.style.background='rgba(255,255,255,0.2)';if(userMarker&&map)userMarker.addTo(map);}else{icon.className='bi bi-eye-slash-fill';btn.style.background='rgba(0,0,0,0.3)';if(userMarker&&map)map.removeLayer(userMarker);}}
		function mostrarToast(mensaje){const toast=document.getElementById('toast-mensaje');toast.innerText=mensaje;toast.style.display='block';toast.style.opacity='1';setTimeout(()=>{toast.style.opacity='0';setTimeout(()=>{toast.style.display='none';},300);},3000);}
		function togglePanelRutas(){if(esConductor)return;const panel=document.getElementById('panel-rutas'),flecha=document.getElementById('flecha-panel');if(panelAbierto){panel.classList.add('oculto');panelAbierto=false;flecha.style.transform='rotate(180deg)';}else{panel.classList.remove('oculto');panelAbierto=true;flecha.style.transform='rotate(0deg)';if(document.getElementById('lista-rutas').children.length===0)cargarAutobuses();}}
		function reproducirIntro(){const top=document.getElementById('romboide-top'),bottom=document.getElementById('romboide-bottom');const centro=document.getElementById('centro-intro'),logo=document.getElementById('logo-intro');const textoC=document.getElementById('texto-cimarron'),textoV=document.getElementById('texto-violeta');const overlay=document.getElementById('intro-overlay');setTimeout(()=>{top.classList.add('juntar');bottom.classList.add('juntar');},500);setTimeout(()=>{top.classList.add('girado');bottom.classList.add('girado');document.getElementById('ventana-mapa').style.display='flex';document.getElementById('bottom-nav').style.display='flex';overlay.style.backgroundColor='transparent';if(!esConductor&&!map){inicializarMapa();}cargarAutobuses();setTimeout(()=>{if(map)map.invalidateSize();},600);},1900);setTimeout(()=>{centro.classList.add('visible');},2200);setTimeout(()=>{logo.classList.add('achicar');textoC.classList.add('subir-junto');textoV.classList.add('subir-junto');top.classList.add('salir');bottom.classList.add('salir');},4000);setTimeout(()=>{textoC.classList.add('difuminar');textoV.classList.add('difuminar');centro.style.transition='opacity 0.8s ease';centro.style.opacity='0';},5000);setTimeout(()=>{sessionStorage.setItem('introVista','true');overlay.style.display='none';if(!esConductor){document.getElementById('panel-rutas').classList.add('oculto');panelAbierto=false;document.getElementById('flecha-panel').style.transform='rotate(180deg)';}},5800);}
		function mostrarMapa(){document.getElementById('intro-overlay').style.display='none';document.getElementById('ventana-mapa').style.display='flex';document.getElementById('bottom-nav').style.display='flex';if(!esConductor&&!map){inicializarMapa();}cargarAutobuses();if(!esConductor){document.getElementById('panel-rutas').classList.add('oculto');panelAbierto=false;document.getElementById('flecha-panel').style.transform='rotate(180deg)';}}
		function inicializarMapa(){if(esConductor)return;map=L.map('map',{zoomControl:false}).setView([31.866,-116.62],14);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap'}).addTo(map);capaRutaActual=L.layerGroup().addTo(map);capaBusqueda=L.layerGroup().addTo(map);if(navigator.geolocation){navigator.geolocation.watchPosition((pos)=>{userLat=pos.coords.latitude;userLng=pos.coords.longitude;if(!esConductor){const ahora=new Date();const hora=ahora.toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit',hour12:false});document.getElementById('txt-ubicacion').innerHTML=hora;}const sesion=JSON.parse(localStorage.getItem('usuarioRutaVioleta')||'{}');let iconoUsuario;if(sesion.imagen_perfil){iconoUsuario=L.divIcon({className:'bg-transparent border-0',html:`<img src="${sesion.imagen_perfil}" style="width:40px;height:40px;border-radius:50%;border:3px solid #d76cdc;object-fit:cover;box-shadow:0 3px 10px rgba(0,0,0,0.5);">`,iconSize:[40,40],iconAnchor:[20,20]});}else{iconoUsuario=L.divIcon({className:'bg-transparent border-0',html:`<div style="background:#d76cdc;width:40px;height:40px;border-radius:50%;display:flex;justify-content:center;align-items:center;border:3px solid white;box-shadow:0 3px 10px rgba(0,0,0,0.5);"><i class="bi bi-person-fill" style="color:white;font-size:24px;"></i></div>`,iconSize:[40,40],iconAnchor:[20,20]});}if(userMarker){userMarker.setLatLng([userLat,userLng]);}else{userMarker=L.marker([userLat,userLng],{icon:iconoUsuario}).bindPopup('Estás aquí');map.setView([userLat,userLng],15);}if(mostrarMiUbicacion&&!map.hasLayer(userMarker)){userMarker.addTo(map);}if(destinoLat&&destinoLng){let distMoved=ultimoCalculoLat?calcularDistancia(ultimoCalculoLat,ultimoCalculoLng,userLat,userLng):1;if(distMoved>0.02||!ultimoCalculoLat){ultimoCalculoLat=userLat;ultimoCalculoLng=userLng;seleccionarDestino(destinoLat,destinoLng);}}},(err)=>console.warn('Error GPS:',err.message),{enableHighAccuracy:true,maximumAge:0,timeout:10000});}map.on('dblclick',(e)=>seleccionarDestino(e.latlng.lat,e.latlng.lng));}
		function centrarEnUsuario(){if(userLat&&userLng&&map)map.setView([userLat,userLng],16);}
		async function buscarSugerencias(query){const cont=document.getElementById('sugerencias-container');if(!cont)return;cont.innerHTML='<div class="sugerencia-item cargando">Buscando...</div>';cont.style.display='block';let res=[];try{res=await buscarEnPhoton(query);}catch(e){}if(res.length<5){const vars=generarVariaciones(query);for(const q of vars){try{res=res.concat(await buscarEnNominatim(q));}catch(e){}if(res.length>=10)break;}}res=deduplicarResultados(res);if(userLat&&userLng)res.sort((a,b)=>calcularDistancia(userLat,userLng,a.lat,a.lng)-calcularDistancia(userLat,userLng,b.lat,b.lng));res=res.slice(0,5);cont.innerHTML='';if(res.length===0){cont.innerHTML='<div class="sugerencia-item vacio">Sin resultados</div>';return;}res.forEach(r=>{const div=document.createElement('div');div.className='sugerencia-item';let extra=userLat?` · ${calcularDistancia(userLat,userLng,r.lat,r.lng).toFixed(2)} km`:'';div.innerHTML=`<strong>${r.nombre}</strong><small>${r.direccion}${extra}</small>`;div.onclick=()=>{cont.style.display='none';document.getElementById('input-busqueda').value=r.nombre;seleccionarDestino(r.lat,r.lng);};cont.appendChild(div);});}
		async function buscarEnPhoton(query){let url=`https://photon.komoot.io/api/?q=${encodeURIComponent(query)}&limit=15`+(userLat?`&lat=${userLat}&lon=${userLng}`:'');const res=await fetch(url);if(!res.ok)throw new Error();const data=await res.json();if(!data.features)return[];return data.features.map(f=>{const p=f.properties||{},c=f.geometry&&f.geometry.coordinates;if(!c)return null;return{nombre:p.name||p.street||p.city||'',direccion:[p.street,p.city].filter(Boolean).join(', '),lat:c[1],lng:c[0],osmId:p.osm_type&&p.osm_id?`${p.osm_type}${p.osm_id}`:null};}).filter(r=>r&&r.nombre&&isFinite(r.lat)&&isFinite(r.lng));}
		async function buscarEnNominatim(query){const url=`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&viewbox=-116.75,31.95,-116.50,31.75&bounded=1&limit=5&addressdetails=1`;const res=await fetch(url,{headers:{'Accept':'application/json'}});if(!res.ok)throw new Error();const data=await res.json();if(!Array.isArray(data))return[];return data.map(r=>{const p=(r.display_name||'').split(',');return{nombre:(p[0]||'').trim(),direccion:p.slice(1,3).join(',').trim(),lat:parseFloat(r.lat),lng:parseFloat(r.lon),osmId:r.osm_type&&r.osm_id?`${r.osm_type}${r.osm_id}`:null};}).filter(r=>r.nombre);}
		function generarVariaciones(q){const v=[],o=q.trim();if(!o)return v;const c=o.replace(/([a-záéíóúñ])([A-ZÁÉÍÓÚÑ])/g,'$1 $2').trim();if(c!==o)v.push(c);const s=o.replace(/\s+/g,'');if(s!==o)v.push(s);const p=o.split(/[^a-zA-ZáéíóúñÁÉÍÓÚÑ0-9]+/).filter(w=>w.length>=3);if(p.length>1)p.forEach(w=>v.push(w));return v.filter(x=>x.toLowerCase()!==o.toLowerCase());}
		function deduplicarResultados(res){const v=new Set(),u=[];for(const r of res){const k=r.osmId||`${r.lat.toFixed(5)},${r.lng.toFixed(5)}`;if(!v.has(k)){v.add(k);u.push(r);}}return u;}
		function puntoMasCercanoEnSegmento(px,py,x1,y1,x2,y2){let dx=x2-x1,dy=y2-y1;if(dx===0&&dy===0)return{lat:x1,lng:y1};let t=((px-x1)*dx+(py-y1)*dy)/(dx*dx+dy*dy);t=Math.max(0,Math.min(1,t));return{lat:x1+t*dx,lng:y1+t*dy};}
		function seleccionarDestino(lat,lng){if(esConductor)return;destinoLat=lat;destinoLng=lng;capaBusqueda.clearLayers();if(!userLat||!userLng){mostrarToast("Esperando ubicación...");return;}fetch(API_TODAS_PARADAS).then(res=>res.json()).then(data=>{if(!data.ok||data.paradas.length===0){mostrarToast("No hay paradas.");return;}let paradas=data.paradas;let paradaInicio=null,minD1=Infinity;paradas.forEach(p=>{let d=calcularDistancia(userLat,userLng,parseFloat(p.latitud),parseFloat(p.longitud));if(d<minD1){minD1=d;paradaInicio=p;}});if(calcularDistancia(userLat,userLng,lat,lng)<minD1){L.marker([lat,lng]).addTo(capaBusqueda).bindPopup('Destino');traerRutaOSRM(userLat,userLng,lat,lng,'#2196F3','walking');mostrarToast("No hay bus cercano...");return;}let rutas={};paradas.forEach(p=>{if(!rutas[p.id_ruta])rutas[p.id_ruta]=[];rutas[p.id_ruta].push(p);});let mejorRuta=null,menorDistDestino=Infinity,puntoSalida=null;for(let idRuta in rutas){let pr=rutas[idRuta];pr.sort((a,b)=>a.orden-b.orden);for(let i=0;i<pr.length-1;i++){let pt=puntoMasCercanoEnSegmento(lat,lng,parseFloat(pr[i].latitud),parseFloat(pr[i].longitud),parseFloat(pr[i+1].latitud),parseFloat(pr[i+1].longitud));let d=calcularDistancia(lat,lng,pt.lat,pt.lng);if(d<menorDistDestino){menorDistDestino=d;mejorRuta=idRuta;puntoSalida=pt;}}}if(!mejorRuta){mostrarToast("No se encontró ruta.");return;}let puntoEntrada=null,menorDistUsuario=Infinity;rutas[mejorRuta].forEach(p=>{let d=calcularDistancia(userLat,userLng,parseFloat(p.latitud),parseFloat(p.longitud));if(d<menorDistUsuario){menorDistUsuario=d;puntoEntrada={lat:parseFloat(p.latitud),lng:parseFloat(p.longitud),nombre:p.nombre};}});let bus=listaAutobuses.find(b=>b.id_ruta==mejorRuta);let busNombre=bus?bus.nombre_autobus:"Micro";L.marker([lat,lng]).addTo(capaBusqueda).bindPopup(`<strong>Destino</strong><br>Toma la ${busNombre}`);L.marker([puntoEntrada.lat,puntoEntrada.lng]).addTo(capaBusqueda).bindPopup(`<strong>Subida</strong><br>${puntoEntrada.nombre} a ${menorDistUsuario.toFixed(2)} km`);L.marker([puntoSalida.lat,puntoSalida.lng]).addTo(capaBusqueda).bindPopup(`<strong>Bajada (Temporal)</strong><br>Baja aquí`);traerRutaOSRM(userLat,userLng,puntoEntrada.lat,puntoEntrada.lng,'#2196F3','walking');traerRutaOSRM(puntoEntrada.lat,puntoEntrada.lng,puntoSalida.lat,puntoSalida.lng,'#d76cdc','driving');let bounds=L.latLngBounds([[userLat,userLng],[lat,lng],[puntoEntrada.lat,puntoEntrada.lng],[puntoSalida.lat,puntoSalida.lng]]);map.fitBounds(bounds,{padding:[50,50]});}).catch(err=>mostrarToast("Error al calcular ruta."));}
		function traerRutaOSRM(lat1,lng1,lat2,lng2,color,perfil){let url=`https://router.project-osrm.org/route/v1/${perfil}/${lng1},${lat1};${lng2},${lat2}?overview=full&geometries=geojson`;fetch(url).then(res=>res.json()).then(data=>{if(data.routes&&data.routes.length>0){L.geoJSON(data.routes[0].geometry,{style:{color:color,weight:5,dashArray:perfil!=='driving'?'8, 8':null}}).addTo(capaBusqueda);}else L.polyline([[lat1,lng1],[lat2,lng2]],{color:color,weight:5,dashArray:perfil!=='driving'?'8, 8':null}).addTo(capaBusqueda);}).catch(()=>L.polyline([[lat1,lng1],[lat2,lng2]],{color:color,weight:5,dashArray:perfil!=='driving'?'8, 8':null}).addTo(capaBusqueda));}
		function cargarAutobuses(){fetch(API_AUTOBUSES).then(res=>res.json()).then(data=>{if(data.ok){listaAutobuses=data.autobuses;const contenedor=document.getElementById('lista-rutas');contenedor.innerHTML='';data.autobuses.forEach(autobus=>{const div=document.createElement('div');div.className='tarjeta-ruta';let slug=autobus.nombre_autobus.toLowerCase().trim().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/\s+/g,'-');div.onclick=function(e){if(e.target.closest('.btn-comentarios'))return;Array.from(contenedor.children).forEach(h=>{if(h!==div)h.style.setProperty('display','none','important');});div.style.setProperty('display','flex','important');document.getElementById('btn-regresar').style.display='block';document.getElementById('panel-rutas').classList.add('ruta-seleccionada');document.getElementById('panel-rutas').classList.remove('oculto');panelAbierto=true;document.getElementById('flecha-panel').style.transform='rotate(0deg)';dibujarRuta(autobus.id_autobus);};div.innerHTML=`<div class="ruta-info">${autobus.nombre_autobus}</div><button class="btn-comentarios" onclick="event.stopPropagation(); window.location.href='/${slug}/comentarios'"><i class="bi bi-chat-dots-fill"></i> Comentarios</button>`;contenedor.appendChild(div);});const urlParams=new URLSearchParams(window.location.search);if(urlParams.has('ruta')&&!esConductor)dibujarRutaPorSlug(urlParams.get('ruta'));else if(urlParams.has('comentarios'))abrirComentariosPorSlug(urlParams.get('comentarios'));if(esConductor)llenarSelectConductor();iniciarConsultaAutobuses();}}).catch(err=>document.getElementById('lista-rutas').innerHTML='<p style="color: red; text-align: center;">Error al cargar.</p>');}
		function dibujarRutaPorSlug(slug){const autobus=listaAutobuses.find(a=>a.nombre_autobus.toLowerCase().trim().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/\s+/g,'-')===slug);if(autobus){dibujarRuta(autobus.id_autobus);document.getElementById('panel-rutas').classList.add('ruta-seleccionada');document.getElementById('btn-regresar').style.display='block';const contenedor=document.getElementById('lista-rutas');Array.from(contenedor.children).forEach(t=>t.style.setProperty('display',t.innerText.includes(autobus.nombre_autobus)?'flex':'none','important'));panelAbierto=true;}else window.location.href="/";}
		function abrirComentariosPorSlug(slug){const autobus=listaAutobuses.find(a=>a.nombre_autobus.toLowerCase().trim().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/\s+/g,'-')===slug);if(autobus)abrirComentarios(autobus.id_autobus,autobus.nombre_autobus);else window.location.href="/";}

		function dibujarRuta(idAutobus) {
			if(esConductor) return;
			capaRutaActual.clearLayers();
			capaBusqueda.clearLayers();
			marcadoresParadas.forEach(m => map.removeLayer(m));
			marcadoresParadas = [];

			fetch(`${API_PARADAS}/${idAutobus}`).then(res => res.json()).then(data => {
				if (data.ok && data.paradas.length > 0) {
					let puntos = [], paradasConCoords = [];
					let contadorVisual = 0;

					data.paradas.forEach((p, index) => {
						const plat = parseFloat(p.latitud), plng = parseFloat(p.longitud);
						puntos.push([plat, plng]); // Para la línea del bus

						let esWaypoint = (p.esWaypoint === true || p.EsWaypoint === true);

						if (!esWaypoint) {
							contadorVisual++;

							// Calculamos el ángulo para la flecha (hacia dónde va)
							let angulo = 0;
							if (index < data.paradas.length - 1) {
								const nextP = data.paradas[index + 1];
								const nlat = parseFloat(nextP.latitud), nlng = parseFloat(nextP.longitud);
								// Fórmula para calcular el ángulo entre dos coordenadas
								angulo = Math.atan2(nlng - plng, nlat - plat) * 180 / Math.PI;
							}

							// Creamos la flecha azul con el número de parada
							let iconoFlecha = L.divIcon({
								className: 'custom-div-icon',
								html: `<div style="background-color: #2196F3; border-radius: 50%; width: 28px; height: 28px; display: flex; justify-content: center; align-items: center; border: 2px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.5); transform: rotate(${angulo}deg);">
										<i class="bi bi-arrow-up" style="color: white; font-size: 16px; transform: rotate(0deg);"></i>
									  </div>
									  <div style="position: absolute; top: 28px; left: 50%; transform: translateX(-50%); background: #000; color: white; font-size: 10px; padding: 1px 4px; border-radius: 5px; font-weight: bold; border: 1px solid #2196F3;">${contadorVisual}</div>`,
								iconSize: [28, 28],
								iconAnchor: [14, 14]
							});

							let marker = L.marker([plat, plng], { icon: iconoFlecha, pane: 'markerPane' })
								.addTo(map)
								.bindPopup(`<strong>Parada ${contadorVisual}: ${p.nombre}</strong>`);

							marcadoresParadas.push(marker);
							paradasConCoords.push({ ...p, latitud: plat, longitud: plng, numeroVisual: contadorVisual });
						}
					});

					if (puntos.length > 1) {
						let coords = puntos.map(p => p[1] + ',' + p[0]).join(';');
						let osrmUrl = `https://router.project-osrm.org/route/v1/driving/${coords}?overview=full&geometries=geojson`;
						fetch(osrmUrl).then(res => res.json()).then(osrmData => {
							if (osrmData.routes && osrmData.routes.length > 0) {
								L.geoJSON(osrmData.routes[0].geometry, { style: { color: '#000000', weight: 8, opacity: 1 } }).addTo(capaRutaActual);
								L.geoJSON(osrmData.routes[0].geometry, { style: { color: '#ffeb3b', weight: 5, opacity: 1 } }).addTo(capaRutaActual);
							}
						}).catch(() => {
							L.polyline(puntos, { color: '#000000', weight: 8, opacity: 1 }).addTo(capaRutaActual);
							L.polyline(puntos, { color: '#ffeb3b', weight: 5, opacity: 1, dashArray: '8, 8' }).addTo(capaRutaActual);
						});
					}

					if (userLat !== null && userLng !== null && paradasConCoords.length > 0) {
						let masCercana = null, menorDistancia = Infinity;
						paradasConCoords.forEach(p => {
							let d = calcularDistancia(userLat, userLng, p.latitud, p.longitud);
							if (d < menorDistancia) { menorDistancia = d; masCercana = p; }
						});

						if (masCercana) {
							let dist = calcularDistancia(userLat, userLng, masCercana.latitud, masCercana.longitud);
							if (dist < 0.2) {
								L.polyline([[userLat, userLng], [masCercana.latitud, masCercana.longitud]], { color: '#ffc107', weight: 4, opacity: 0.9, dashArray: '8, 8' }).addTo(capaRutaActual);
							} else {
								let osrmWalkUrl = `https://router.project-osrm.org/route/v1/foot/${userLng},${userLat};${masCercana.longitud},${masCercana.latitud}?overview=full&geometries=geojson`;
								fetch(osrmWalkUrl).then(res => res.json()).then(walkData => {
									if (walkData.routes && walkData.routes.length > 0) {
										L.geoJSON(walkData.routes[0].geometry, { style: { color: '#279FF5', weight: 4, opacity: 0.9, dashArray: '8, 8' } }).addTo(capaRutaActual);
									} else throw new Error();
								}).catch(() => L.polyline([[userLat, userLng], [masCercana.latitud, masCercana.longitud]], { color: '#ffc107', weight: 3, opacity: 0.8, dashArray: '8, 8' }).addTo(capaRutaActual));
							}
							L.circleMarker([masCercana.latitud, masCercana.longitud], { radius: 12, fillColor: "transparent", color: "#ffc107", weight: 3, pane: 'markerPane' }).addTo(capaRutaActual).bindPopup(`Parada más cercana: <strong>${masCercana.numeroVisual}. ${masCercana.nombre}</strong><br>A ${menorDistancia.toFixed(2)} km de ti`);
						}
					}
					setTimeout(() => { if (capaRutaActual.getLayers().length > 0) map.fitBounds(capaRutaActual.getBounds(), { padding: [30, 30] }); }, 500);
				}
			}).catch(err => console.error("Error al dibujar ruta:", err));
		}

		function calcularDistancia(lat1,lon1,lat2,lon2){const R=6371,dLat=(lat2-lat1)*Math.PI/180,dLon=(lon2-lon1)*Math.PI/180;const a=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)*Math.sin(dLon/2);return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));}
		function regresarRutas(){if(capaRutaActual)capaRutaActual.clearLayers();if(capaBusqueda)capaBusqueda.clearLayers();if(marcadoresParadas){marcadoresParadas.forEach(m=>{if(map)map.removeLayer(m);});marcadoresParadas=[];}destinoLat=null;destinoLng=null;ultimoCalculoLat=null;ultimoCalculoLng=null;document.getElementById('btn-regresar').style.display='none';const panel=document.getElementById('panel-rutas');if(panel){panel.classList.remove('ruta-seleccionada');panel.classList.remove('oculto');}panelAbierto=true;document.getElementById('flecha-panel').style.transform='rotate(0deg)';const contenedor=document.getElementById('lista-rutas');if(contenedor){Array.from(contenedor.children).forEach(t=>t.style.setProperty('display','flex','important'));contenedor.scrollTop=0;}if(window.location.pathname!=='/'||window.location.search)window.history.pushState({},'','/');}
		function abrirComentarios(id,nombre){idAutobusActual=id;comentariosCargados=0;document.getElementById('nombre-autobus').innerText=nombre;document.getElementById('ventana-comentarios').style.display='flex';document.getElementById('contenido-comentarios').innerHTML='<p style="color:white; text-align:center;">Cargando comentarios...</p>';cargarComentarios();}
		function cerrarComentarios(){document.getElementById('ventana-comentarios').style.display='none';window.location.href="/";}
		function cargarComentarios(){const sesion=JSON.parse(localStorage.getItem('usuarioRutaVioleta')||'{}');const idU=sesion.id_usuario||0;const esAdmin=sesion.es_admin===true;fetch(`${API_COMENTARIOS}/${idAutobusActual}?skip=${comentariosCargados}&id_usuario=${idU}`).then(res=>res.json()).then(data=>{if(data.ok){let contenedor=document.getElementById('contenido-comentarios');if(comentariosCargados===0){contenedor.innerHTML=`<div style="text-align: center; margin-bottom: 20px; background: #1e1e1e; padding: 20px; border-radius: 15px;"><div style="font-size: 3rem; font-weight: bold; color: #d76cdc;">${data.promedio}</div><div style="color: #ffc107; font-size: 1.5rem;">${getEstrellasVisuales(data.promedio)}</div><div style="color: #888; font-size: 0.9rem;">${data.total} Reseñas</div></div><div id="lista-comentarios"></div>`;}const lista=document.getElementById('lista-comentarios');if(data.comentarios.length===0&&comentariosCargados===0){lista.innerHTML='<p style="text-align: center; color: #aaa;">Sin comentarios...</p>';}else{data.comentarios.forEach(c=>{let btnAdmin="";if(esAdmin){let estilo="background:none; border:none; cursor:pointer; margin-left: 10px; padding: 0;";let btnAceptar=`<button title="Aceptar" onclick="cambiarEstadoComentario(${c.id_comentario}, true)" style="${estilo} color:#4caf50;"><i class="bi bi-check-lg"></i></button>`;let btnPendiente=`<button title="Pendiente" onclick="cambiarEstadoComentario(${c.id_comentario}, false)" style="${estilo} color:#ffc107;"><i class="bi bi-clock"></i></button>`;let btnEliminar=`<button title="Eliminar" onclick="eliminarComentarioAdmin(${c.id_comentario})" style="${estilo} color:#ff4444;"><i class="bi bi-trash"></i></button>`;btnAdmin=(c.es_aprobado===true)?`${btnPendiente}${btnEliminar}`:`${btnAceptar}${btnEliminar}`;}let nombreMostrar=c.es_anonimo?"Anónimo":String.fromCharCode(64)+c.autor;let enlacePerfil=c.es_anonimo?"/Perfil/anonimo":"/Perfil/"+c.autor;let colorTexto="#ccc";let etiquetaAviso="";if(esAdmin&&c.es_aprobado!==true){colorTexto="#f44336";etiquetaAviso=" <strong>(Pendiente)</strong>";}const card=document.createElement('div');card.style.cssText="background: #222; padding: 15px; border-radius: 12px; margin-bottom: 10px; color: white;";card.innerHTML=`<div style="display: flex; justify-content: space-between; margin-bottom: 5px; align-items: center;"><div><a href="${enlacePerfil}" style="color: white; text-decoration: none; font-weight: bold;">${nombreMostrar}</a>${btnAdmin}</div><span style="color: #ffc107;">${getEstrellasVisuales(c.calificacion)}</span></div><p style="margin: 0; font-size: 0.9rem; color: ${colorTexto};">${c.contenido}${etiquetaAviso}</p><div style="text-align: right; font-size: 0.75rem; color: #666; margin-top: 5px;">${c.fecha}</div><div style="display:flex; gap:10px; margin-top:5px; align-items:center;"><button onclick="votarComentario(${c.id_comentario}, 1)" style="background:${c.miVoto===1?'#4caf50':'none'}; border:none; border-radius:5px; padding:2px 5px; color:${c.miVoto===1?'white':'#4caf50'}; cursor:pointer;"><i class="bi bi-arrow-up"></i></button><span id="votos-${c.id_comentario}">${c.votos}</span><button onclick="votarComentario(${c.id_comentario}, -1)" style="background:${c.miVoto===-1?'#f44336':'none'}; border:none; border-radius:5px; padding:2px 5px; color:${c.miVoto===-1?'white':'#f44336'}; cursor:pointer;"><i class="bi bi-arrow-down"></i></button></div>`;lista.appendChild(card);});}comentariosCargados+=data.comentarios.length;}});}
		function cambiarEstadoComentario(id, aprobado) {const sesion = JSON.parse(localStorage.getItem('usuarioRutaVioleta') || '{}');fetch(`${API_COMENTARIOS}/estado/${id}`, {method: 'PUT',headers: { 'Content-Type': 'application/json' },body: JSON.stringify({ Aprobado: aprobado, NombreAdmin: sesion.nombre_acceso })}).then(res => res.json()).then(data => {if (data.ok) {comentariosCargados = 0;cargarComentarios();} else {alert("Error al cambiar el estado");}});}
		function votarComentario(idComentario,valor){const sesion=JSON.parse(localStorage.getItem('usuarioRutaVioleta')||'{}');if(!sesion.id_usuario){mostrarToast("Inicia sesión para votar");return;}fetch(`${API_COMENTARIOS}/votar`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idComentario,idUsuario:sesion.id_usuario,valor})}).then(res=>res.json()).then(data=>{if(data.ok){document.getElementById(`votos-${idComentario}`).innerText=data.nuevosVotos;comentariosCargados=0;cargarComentarios();}});}
		function eliminarComentarioAdmin(id){if(!confirm("¿Seguro quieres eliminar?"))return;const sesion=JSON.parse(localStorage.getItem('usuarioRutaVioleta')||'{}');if(!sesion.nombre_acceso){alert("Vuelve a iniciar sesión.");return;}fetch(`${API_COMENTARIOS}/${id}/${sesion.nombre_acceso}`,{method:'DELETE',headers:{'Content-Type':'application/json'}}).then(async res=>{const data=await res.json();if(res.ok){comentariosCargados=0;cargarComentarios();}else alert("Error: "+(data.error||"No se pudo borrar."));}).catch(err=>alert("Error de conexión."));}
		function getEstrellasVisuales(num){let e='';for(let i=1;i<=5;i++)e+=i<=num?'★':'☆';return e;}
		function abrirFormularioComentario(){document.getElementById('formulario-comentario').style.display='flex';estrellasSeleccionadas=0;document.querySelectorAll('#selector-estrellas .estrella').forEach(s=>s.style.color='#444');document.getElementById('texto-comentario').value='';document.getElementById('alerta-comentario').style.display='none';const sesion=localStorage.getItem('usuarioRutaVioleta'),txt=document.getElementById('texto-autor-comentario');if(sesion)txt.innerHTML=`Escribir como: <strong style="color: #d76cdc;">${String.fromCharCode(64)+JSON.parse(sesion).nombre_acceso}</strong>`;else txt.innerHTML=`Escribir como: <strong style="color: #d76cdc;">Anónimo</strong>`;}
		function cerrarFormularioComentario(){document.getElementById('formulario-comentario').style.display='none';}
		function enviarComentario(){const btn=document.getElementById('btn-enviar-comentario'),alerta=document.getElementById('alerta-comentario'),texto=document.getElementById('texto-comentario').value.trim();if(texto.length<10){alerta.style.display='block';alerta.style.backgroundColor='#f44336';alerta.innerText='Mínimo 10 caracteres.';return;}if(estrellasSeleccionadas===0){alerta.style.display='block';alerta.style.backgroundColor='#f44336';alerta.innerText='Selecciona estrellas.';return;}btn.disabled=true;btn.innerText='Enviando...';alerta.style.display='none';let idUsuario=null,sesion=localStorage.getItem('usuarioRutaVioleta');if(sesion){try{idUsuario=JSON.parse(sesion).id_usuario||null;}catch(e){}}fetch(API_COMENTARIOS,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idAutobus:idAutobusActual,idUsuario,contenido:texto,calificacion:estrellasSeleccionadas})}).then(res=>res.json().then(data=>({status:res.status,body:data}))).then(res=>{if(res.status===200&&res.body.ok){alerta.style.display='block';alerta.style.backgroundColor='#4caf50';alerta.innerText=res.body.mensaje;setTimeout(()=>cerrarFormularioComentario(),3000);}else{alerta.style.display='block';alerta.style.backgroundColor='#f44336';alerta.innerText=res.body.error||'Error.';btn.disabled=false;btn.innerText='Enviar';}}).catch(()=>{alerta.style.display='block';alerta.style.backgroundColor='#f44336';alerta.innerText='Error de conexión.';btn.disabled=false;btn.innerText='Enviar';});}
		function llenarSelectConductor(){const select=document.getElementById('select-autobus-conductor');if(!select)return;select.innerHTML='<option value="">Selecciona una unidad...</option>';listaAutobuses.forEach(bus=>select.innerHTML+=`<option value="${bus.id_autobus}">${bus.nombre_autobus}</option>`);}
		function actualizarReloj(){const ahora=new Date();const hora=ahora.toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit',hour12:false});document.getElementById('txt-ubicacion').innerHTML=hora;}
		async function toggleUbicacion(){const sesion=JSON.parse(localStorage.getItem('usuarioRutaVioleta')||'{}'),idAutobus=document.getElementById('select-autobus-conductor').value;const btn=document.getElementById('btn-switch-ubicacion'),txt=document.getElementById('txt-switch-estado');if(!estadoUbicacion&&!idAutobus){mostrarToast("Selecciona unidad");return;}estadoUbicacion=!estadoUbicacion;if(estadoUbicacion){btn.style.backgroundColor='#4caf50';txt.innerText='Ubicación Compartida';document.getElementById('txt-ultima-actualizacion').innerText="Última actualización: En vivo";await fetch(`https://api.4chan.world/api/ubicaciones/toggle/${sesion.id_usuario}`,{method:'POST'});enviarUbicacionActual(sesion.id_usuario,idAutobus);intervaloUbicacion=setInterval(()=>enviarUbicacionActual(sesion.id_usuario,idAutobus),5000);}else{btn.style.backgroundColor='#f44336';txt.innerText='Ubicación Apagada';const hora=new Date().toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'});document.getElementById('txt-ultima-actualizacion').innerText=`Última actualización: ${hora}`;await fetch(`https://api.4chan.world/api/ubicaciones/toggle/${sesion.id_usuario}`,{method:'POST'});if(intervaloUbicacion)clearInterval(intervaloUbicacion);}}
		function enviarUbicacionActual(idConductor,idAutobus){if(!userLat||!userLng)return;fetch('https://api.4chan.world/api/ubicaciones/actualizar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idConductor,latitud:userLat,longitud:userLng,idAutobus:parseInt(idAutobus)})}).catch(err=>console.error("Error GPS",err));}
		function iniciarConsultaAutobuses(){if(intervaloConsultaBuses)clearInterval(intervaloConsultaBuses);if(!esConductor){consultarAutobusesEnMapa();intervaloConsultaBuses=setInterval(consultarAutobusesEnMapa,2000);}}
		function consultarAutobusesEnMapa(){if(esConductor)return;fetch('https://api.4chan.world/api/ubicaciones/activas').then(res=>res.json()).then(data=>{if(!data.ok||!map)return;marcadoresAutobuses.forEach(m=>map.removeLayer(m));marcadoresAutobuses=[];const iconoBus=L.divIcon({className:'bg-transparent border-0',html:`<div style='background-color:#d76cdc; border-radius:50%; width:40px; height:40px; display:flex; justify-content:center; align-items:center; border:2px solid white; box-shadow: 0 3px 10px rgba(0,0,0,0.5);'><i class='bi bi-bus-front-fill' style='color:white; font-size:20px;'></i></div>`,iconSize:[40,40],iconAnchor:[20,20],pane:'markerPane'});data.ubicaciones.forEach(ubi=>{const lat=parseFloat(ubi.latitud),lng=parseFloat(ubi.longitud);if(isNaN(lat)||isNaN(lng))return;const segundos=Math.floor((new Date()-new Date(ubi.ultima_actualizacion))/1000);let tiempo="hace unos segundos";if(segundos>=60&&segundos<3600)tiempo=`hace ${Math.floor(segundos/60)} min`;else if(segundos>=3600)tiempo=`hace ${Math.floor(segundos/3600)} horas`;const marker=L.marker([lat,lng],{icon:iconoBus,pane:'markerPane'}).addTo(map).bindPopup(`<div style="text-align:center;"><strong style="color:#d76cdc; font-size:1.1rem;">${ubi.nombre_autobus}</strong><br><span style="font-size:0.9rem;">Conductor: ${ubi.nombre_conductor}</span><br><small style="color:#888;">Actualizado ${tiempo}</small></div>`);marcadoresAutobuses.push(marker);});}).catch(err=>console.error("Error consultando buses:",err));}
	</script>